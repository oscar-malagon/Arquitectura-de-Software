pipeline {
    agent {
        kubernetes {
            yaml '''
                apiVersion: v1
                kind: Pod
                spec:
                  containers:
                  - name: kaniko
                    image: gcr.io/kaniko-project/executor:debug
                    command:
                    - /busybox/cat
                    tty: true
                    volumeMounts:
                    - name: docker-config
                      mountPath: /kaniko/.docker
                  volumes:
                  - name: docker-config
                    secret:
                      secretName: docker-config
                      items:
                        - key: .dockerconfigjson
                          path: config.json
            '''
        }
    }
    
    environment {
        DOCKER_REGISTRY = 'registry.digitalocean.com/crypto-dashboard'
        VERSION = "${BUILD_NUMBER}"
        PROJECT_DIR = 'crypto-dashboard-con-manual-update'
    }
    
    stages {
        stage('Build and Push Images') {
            steps {
                container('kaniko') {
                    // Build and push frontend
                    sh "/kaniko/executor --context ${WORKSPACE}/${PROJECT_DIR}/frontend --destination ${DOCKER_REGISTRY}/frontend:${VERSION} --destination ${DOCKER_REGISTRY}/frontend:latest"
                    
                    // Build and push API
                    sh "/kaniko/executor --context ${WORKSPACE}/${PROJECT_DIR}/api --destination ${DOCKER_REGISTRY}/api:${VERSION} --destination ${DOCKER_REGISTRY}/api:latest"
                    
                    // Build and push price service
                    sh "/kaniko/executor --context ${WORKSPACE}/${PROJECT_DIR}/price-service --destination ${DOCKER_REGISTRY}/price-service:${VERSION} --destination ${DOCKER_REGISTRY}/price-service:latest"
                    
                    // Build and push prediction service
                    sh "/kaniko/executor --context ${WORKSPACE}/${PROJECT_DIR}/prediction-service --destination ${DOCKER_REGISTRY}/prediction-service:${VERSION} --destination ${DOCKER_REGISTRY}/prediction-service:latest"
                }
            }
        }
    }
} 