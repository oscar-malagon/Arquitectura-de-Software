pipeline {
    agent {
        kubernetes {
            yaml '''
                apiVersion: v1
                kind: Pod
                spec:
                  containers:
                  - name: kaniko
                    image: gcr.io/kaniko-project/executor:debug
                    command:
                    - /busybox/cat
                    tty: true
                    volumeMounts:
                    - name: docker-config
                      mountPath: /kaniko/.docker
                    - name: workspace-volume
                      mountPath: /workspace
                  volumes:
                  - name: docker-config
                    secret:
                      secretName: docker-config
                      items:
                        - key: .dockerconfigjson
                          path: config.json
                  - name: workspace-volume
                    emptyDir: {}
            '''
        }
    }
    
    environment {
        DOCKER_REGISTRY = 'registry.digitalocean.com/crypto-dashboard'
        VERSION = "${BUILD_NUMBER}"
    }
    
    stages {
        stage('Build and Push Images') {
            steps {
                container('kaniko') {
                    // Build and push frontend
                    sh '''
                        /kaniko/executor \
                        --context="$WORKSPACE/frontend" \
                        --dockerfile="$WORKSPACE/frontend/Dockerfile" \
                        --destination=${DOCKER_REGISTRY}/frontend:${VERSION} \
                        --destination=${DOCKER_REGISTRY}/frontend:latest \
                        --verbosity=debug
                    '''
                    
                    // Build and push API
                    sh '''
                        /kaniko/executor \
                        --context="$WORKSPACE/api" \
                        --dockerfile="$WORKSPACE/api/Dockerfile" \
                        --destination=${DOCKER_REGISTRY}/api:${VERSION} \
                        --destination=${DOCKER_REGISTRY}/api:latest \
                        --verbosity=debug
                    '''
                    
                    // Build and push price service
                    sh '''
                        /kaniko/executor \
                        --context="$WORKSPACE/price-service" \
                        --dockerfile="$WORKSPACE/price-service/Dockerfile" \
                        --destination=${DOCKER_REGISTRY}/price-service:${VERSION} \
                        --destination=${DOCKER_REGISTRY}/price-service:latest \
                        --verbosity=debug
                    '''
                    
                    // Build and push prediction service
                    sh '''
                        /kaniko/executor \
                        --context="$WORKSPACE/prediction-service" \
                        --dockerfile="$WORKSPACE/prediction-service/Dockerfile" \
                        --destination=${DOCKER_REGISTRY}/prediction-service:${VERSION} \
                        --destination=${DOCKER_REGISTRY}/prediction-service:latest \
                        --verbosity=debug
                    '''
                }
            }
        }
    }
} 