pipeline {
    agent {
        kubernetes {
            yaml '''
                apiVersion: v1
                kind: Pod
                spec:
                  containers:
                  - name: kaniko
                    image: gcr.io/kaniko-project/executor:v1.9.1-debug
                    command:
                    - /busybox/cat
                    tty: true
                    volumeMounts:
                    - name: docker-config
                      mountPath: /kaniko/.docker
                    - name: workspace-volume
                      mountPath: /workspace
                    resources:
                      requests:
                        memory: "1Gi"
                        cpu: "500m"
                      limits:
                        memory: "2Gi"
                        cpu: "1"
                  volumes:
                  - name: docker-config
                    secret:
                      secretName: docker-config
                      items:
                        - key: .dockerconfigjson
                          path: config.json
                  - name: workspace-volume
                    emptyDir: {}
            '''
        }
    }
    
    environment {
        DOCKER_REGISTRY = 'registry.digitalocean.com/crypto-dashboard'
        VERSION = "${BUILD_NUMBER}"
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Debug Workspace') {
            steps {
                container('kaniko') {
                    sh '''
                        echo "Current directory:"
                        pwd
                        echo "Directory contents:"
                        ls -la
                        echo "Checking Dockerfiles:"
                        find . -name "Dockerfile" -type f
                        echo "Checking if files are readable:"
                        for df in $(find . -name "Dockerfile" -type f); do
                            echo "Testing $df:"
                            cat $df > /dev/null && echo "  ✓ Readable" || echo "  ✗ Not readable"
                        done
                    '''
                }
            }
        }
        
        stage('Build and Push Images') {
            steps {
                container('kaniko') {
                    script {
                        def buildImage = { service ->
                            sh """
                                echo "Building ${service}..."
                                /kaniko/executor \\
                                --context=\$(pwd)/${service} \\
                                --dockerfile=\$(pwd)/${service}/Dockerfile \\
                                --destination=\${DOCKER_REGISTRY}/${service}:\${VERSION} \\
                                --destination=\${DOCKER_REGISTRY}/${service}:latest \\
                                --verbosity=debug \\
                                --cache=true \\
                                --cache-ttl=24h \\
                                --snapshot-mode=redo \\
                                --use-new-run \\
                                --cleanup
                            """
                        }
                        
                        // Build all services in parallel
                        parallel(
                            frontend: {
                                buildImage('frontend')
                            },
                            api: {
                                buildImage('api')
                            },
                            'price-service': {
                                buildImage('price-service')
                            },
                            'prediction-service': {
                                buildImage('prediction-service')
                            }
                        )
                    }
                }
            }
        }
    }
    
    post {
        failure {
            echo 'Build failed! Check the logs above for details.'
        }
        success {
            echo 'All images built and pushed successfully!'
        }
        always {
            echo 'Cleaning up workspace...'
            cleanWs()
        }
    }
} 