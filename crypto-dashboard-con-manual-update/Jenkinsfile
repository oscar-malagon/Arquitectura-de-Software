pipeline {
    agent {
        kubernetes {
            yaml '''
                apiVersion: v1
                kind: Pod
                spec:
                  containers:
                  - name: kaniko
                    image: gcr.io/kaniko-project/executor:v1.9.1-debug
                    command:
                    - /busybox/cat
                    tty: true
                    volumeMounts:
                    - name: docker-config
                      mountPath: /kaniko/.docker
                    - name: workspace-volume
                      mountPath: /workspace
                  volumes:
                  - name: docker-config
                    secret:
                      secretName: docker-config
                      items:
                        - key: .dockerconfigjson
                          path: config.json
                  - name: workspace-volume
                    emptyDir: {}
            '''
        }
    }
    
    environment {
        DOCKER_REGISTRY = 'registry.digitalocean.com/crypto-dashboard'
        VERSION = "${BUILD_NUMBER}"
    }
    
    stages {
        stage('Debug Workspace') {
            steps {
                container('kaniko') {
                    sh '''
                        echo "Current directory:"
                        pwd
                        echo "Directory contents:"
                        ls -la
                        echo "Checking Dockerfiles:"
                        find . -name "Dockerfile"
                    '''
                }
            }
        }
        
        stage('Build and Push Images') {
            steps {
                container('kaniko') {
                    script {
                        def WORKSPACE_PATH = sh(script: 'pwd', returnStdout: true).trim()
                        
                        // Build and push frontend
                        sh """
                            echo "Building frontend..."
                            /kaniko/executor \\
                            --context=${WORKSPACE_PATH} \\
                            --dockerfile=${WORKSPACE_PATH}/frontend/Dockerfile \\
                            --destination=\${DOCKER_REGISTRY}/frontend:\${VERSION} \\
                            --destination=\${DOCKER_REGISTRY}/frontend:latest \\
                            --verbosity=debug \\
                            --cache=true \\
                            --cleanup
                        """
                        
                        // Build and push API
                        sh """
                            echo "Building API..."
                            /kaniko/executor \\
                            --context=${WORKSPACE_PATH} \\
                            --dockerfile=${WORKSPACE_PATH}/api/Dockerfile \\
                            --destination=\${DOCKER_REGISTRY}/api:\${VERSION} \\
                            --destination=\${DOCKER_REGISTRY}/api:latest \\
                            --verbosity=debug \\
                            --cache=true \\
                            --cleanup
                        """
                        
                        // Build and push price service
                        sh """
                            echo "Building price service..."
                            /kaniko/executor \\
                            --context=${WORKSPACE_PATH} \\
                            --dockerfile=${WORKSPACE_PATH}/price-service/Dockerfile \\
                            --destination=\${DOCKER_REGISTRY}/price-service:\${VERSION} \\
                            --destination=\${DOCKER_REGISTRY}/price-service:latest \\
                            --verbosity=debug \\
                            --cache=true \\
                            --cleanup
                        """
                        
                        // Build and push prediction service
                        sh """
                            echo "Building prediction service..."
                            /kaniko/executor \\
                            --context=${WORKSPACE_PATH} \\
                            --dockerfile=${WORKSPACE_PATH}/prediction-service/Dockerfile \\
                            --destination=\${DOCKER_REGISTRY}/prediction-service:\${VERSION} \\
                            --destination=\${DOCKER_REGISTRY}/prediction-service:latest \\
                            --verbosity=debug \\
                            --cache=true \\
                            --cleanup
                        """
                    }
                }
            }
        }
    }
} 